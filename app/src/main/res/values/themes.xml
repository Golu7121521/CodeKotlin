<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Gitbox" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/terminal_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Gitbox.Main</item>
    </style>

    <style name="Theme.Gitbox.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/terminal_background</item>
        <item name="android:navigationBarColor">@color/terminal_background</item>
        <item name="android:windowBackground">@color/terminal_background</item>
    </style>
</resources>
